[Unit]
Description=SC data capture supervisor (idle until pmcapture start)
Documentation=man:pmcapture(1)
After=network.target

[Service]
Type=simple
ExecStart=/usr/share/raft/examples/python/pmcapture/pmcapture daemon
Restart=on-failure
RestartSec=3

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
